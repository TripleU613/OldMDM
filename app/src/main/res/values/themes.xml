<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Base application theme.
      Changed parent from Material3 to AppCompat to ensure compatibility.
    -->
    <style name="Base.Theme.Oldmdm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Oldmdm" parent="Base.Theme.Oldmdm" />

    <!-- Custom Style for the Switches -->
    <style name="MDMSwitch" parent="Theme.AppCompat.Light">
        <!-- colorPrimary is used for the activated thumb -->
        <item name="colorPrimary">@color/mdm_accent_cyan</item>
        <!-- colorControlNormal is used for the inactive thumb -->
        <item name="colorControlNormal">@color/mdm_text_grey</item>
        <!-- colorAccent is used for the activated track -->
        <item name="colorAccent">@color/mdm_accent_cyan</item>
    </style>

</resources>
