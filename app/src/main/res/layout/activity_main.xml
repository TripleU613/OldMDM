<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mdm_background_blue"
    android:padding="16dp"
    tools:context="com.android.cts.tripleu.oldmdm.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer_text"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Group for when MDM is NOT set up -->
            <LinearLayout
                android:id="@+id/setup_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/device_owner_required"
                    android:textColor="@color/mdm_text_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/to_use_this_app_grant_device_owner_permission"
                    android:textColor="@color/mdm_text_white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Group for when MDM is ready to be activated -->
            <LinearLayout
                android:id="@+id/activate_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/filter_configuration"
                    android:textColor="@color/mdm_text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switch_browser"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/block_browsers"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Switch
                    android:id="@+id/switch_email"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/block_email"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Switch
                    android:id="@+id/switch_texting"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/block_texting"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Switch
                    android:id="@+id/switch_radio"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/block_fm_radio"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Switch
                    android:id="@+id/switch_video"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/block_video"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Switch
                    android:id="@+id/switch_camera"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nextFocusDown="@id/btn_activate_filter"
                    android:text="@string/block_camera"
                    android:textColor="@color/mdm_text_white"
                    android:theme="@style/MDMSwitch"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <Button
                    android:id="@+id/btn_activate_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/mdm_button_blue"
                    android:focusable="true"
                    android:nextFocusUp="@id/switch_camera"
                    android:text="@string/activate_filter"
                    android:textColor="@color/mdm_text_white" />
            </LinearLayout>

            <!-- Group for when MDM is active and can be deactivated -->
            <LinearLayout
                android:id="@+id/deactivate_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/enter_pin_to_uninstall"
                    android:textColor="@color/mdm_text_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_device_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/mdm_text_grey"
                    android:textSize="12sp"
                    tools:text="Device ID: 12345-ABCDE" />

                <TextView
                    android:id="@+id/pin_status_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/connecting"
                    android:textColor="@color/mdm_text_grey"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_pin_entry"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:autofillHints=""
                    android:backgroundTint="@color/mdm_accent_cyan"
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="-------"
                    android:inputType="numberPassword"
                    android:maxLength="7"
                    android:nextFocusDown="@id/btn_deactivate"
                    android:textColor="@color/mdm_text_white"
                    android:textColorHint="@color/mdm_text_grey"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btn_deactivate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/mdm_button_blue"
                    android:focusable="true"
                    android:nextFocusUp="@id/et_pin_entry"
                    android:text="@string/deactivate"
                    android:textColor="@color/mdm_text_white"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Text remains at the bottom -->
    <TextView
        android:id="@+id/footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="@string/_2025_tripleutech_nhead_to_tripleu_org_for_donations_and_contact"
        android:textColor="@color/mdm_text_grey"
        android:textSize="10sp"
        tools:ignore="SmallSp" />

</RelativeLayout>
