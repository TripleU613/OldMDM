<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- ScrollView makes the content accessible on small screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer_text"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Group for when MDM is NOT set up -->
            <LinearLayout
                android:id="@+id/setup_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/device_owner_required"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/to_use_this_app_grant_device_owner_permission_via_adb_on_a_factory_reset_device"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Group for when MDM is ready to be activated -->
            <LinearLayout
                android:id="@+id/activate_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mdm_ready"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_activate_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:focusable="true"
                    android:text="@string/activate_filter" />
            </LinearLayout>

            <!-- Group for when MDM is active and can be deactivated -->
            <LinearLayout
                android:id="@+id/deactivate_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_pin_to_uninstall"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pin_status_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/connecting"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/et_pin_entry"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:autofillHints=""
                    android:focusable="true"
                    android:gravity="center"
                    android:hint="@string/lines"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:nextFocusDown="@id/btn_deactivate" />

                <Button
                    android:id="@+id/btn_deactivate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:focusable="true"
                    android:nextFocusUp="@id/et_pin_entry"
                    android:text="@string/deactivate_and_uninstall" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer Text remains at the bottom -->
    <TextView
        android:id="@+id/footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="@string/_2025_tripleutech_nhead_to_tripleu_org_for_donations_and_contact"
        android:textColor="#888888"
        android:textSize="10sp"
        tools:ignore="SmallSp" />

</RelativeLayout>
